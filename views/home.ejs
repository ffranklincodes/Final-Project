<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Limitless Mathematics</title>
    <%- include('partials/header.ejs') %>
        <link rel="stylesheet" href="/public/css/home.css" type="text/css" />
</head>

<body>
    <%- include('partials/navbar.ejs') %>

        <main>
            <div class="website_name_logo"><img src="/public/images/Maths logo4.png" style="width: 100px">
                <h1 style="display: inline-block;">Limitless Mathematics</h1>
            </div>
            <div class="top_row">
                <section class="section1">
                    <div class="main_label">For teachers and students</div>

                    <div>

                        <h2>Make maths practice limitless.</h2>
                    </div>

                    <div>

                        <p>
                            Create worksheets, share questions, and help students build confidence
                            in mathematics, one question at a time.
                        </p>

                    </div>

                    <div class="home_buttons">
                        <a href="/register"> <button type="button" class="register_button">Register </button></a>
                        <a href="/login"> <button type="button" class="login_button">Explore Questions</button></a>
                    </div>
                </section>

                <section class="features_section">
                    <div class="section_heading">
                        <h2>Everything you need for maths practice.</h2>
                        <p>A simple platform connecting teaching, learning, and practice.</p>
                    </div>

                    <div class="features">
                        <div class="feature-card">
                            <div class="feature-icon">&#128196;</div>
                            <h3>Create Worksheets</h3>
                            <p>Build customised maths tasks using a collection of questions.</p>
                        </div>

                        <div class="feature-card">
                            <div class="feature-icon">&#128269;</div>
                            <h3>Find Questions</h3>
                            <p>
                                Search for questions that suit your lessons and learning goals.
                            </p>
                        </div>

                        <div class="feature-card">
                            <div class="feature-icon">&#128101;</div>
                            <h3>Share with Students</h3>
                            <p>Organise tasks for your classes and make practice accessible.</p>
                        </div>

                        <div class="feature-card">
                            <div class="feature-icon">&#10004;</div>
                            <h3>Practise and Learn</h3>
                            <p>
                                Answer maths questions and check your understanding as you learn.
                            </p>
                        </div>
                    </div>
                </section>


            </div>
        </main>

        <footer>&copy; 2026 Limitless Mathematics. All rights reserved.</footer>
</body>

</html>