<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Contact - Limitless Mathematics</title>
        <%- include('partials/header.ejs') %>
        <link href="/public/css/contact.css" rel="stylesheet" type="text/css">
    </head>
    <body>
        <%- include('partials/navbar.ejs') %>
        <h1 class="page_title">Contact us</h1>
        <br>
        <form action="/contact" method="POST">
            <div class="contact-container">
                    <div class="box-role">
                            <h2>Choose your role:</h3>
                            <div class="contact-role-options">
                                <input type="radio" id="teacher" name="role" value="teacher">
                                <label for="teacher" class="radio-label" type = "button">Teacher</label>

                                <input type="radio" id="student" name="role" value="student">
                                <label for="student" class="radio-label">Student</label>

                                <input type="radio" id="parent" name="role" value="parent">
                                <label for="parent" class="radio-label">Parent/Caregiver</label>
                            </div>
                            <br>
                    </div>
                    
                    <h2>Enter your contact information:</h2>

                    <div class="contact-info" >
                        <label for="contact_name">Name:</label>
                        <input type="text" id ="contact_name" name="contact_name" minlength="2" maxlength="56" required>
                    </div>
                    <div class="contact-info" >
                        <label for="contact_email">Email:</label>
                        <input type="email" id="contact_email" name="contact_email" required>
                    </div>
                    <div class="contact-info" >
                        <label for="contact_city">City:</label>
                        <input type="text" id ="contact_city" name="contact_city" minlength="2" maxlength="56" required>
                    </div>
                    <div class="contact-info" >
                        <label for="contact_country">Country:</label>
                        <input  type="text" id="contact_country" name="contact_country" required>
                    </div>

                    <div class="box-message">
                        <br>
                        <label for="contact_subject">
                            Subject <input name="contact_subject">
                        </label>
                        
                        <label for="contact_message">Leave your comments, suggestion or querries:</label>
                        <br>
                        
                        <textarea type="text" id="contact_message" name="contact_message" maxlength="500" required></textarea>
                        
                        <input type="hidden" id="status" name="status" value="unread">
                    </div>
                    

                    <div class="container-contact-button">
                        <button class="contact-button" type="submit">Submit</button>
                    </div>
            </div>
        </form>
    </body>

</html>