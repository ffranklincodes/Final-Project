<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - Worksheet Builder</title>
    <%- include('partials/header.ejs') %>
        <link rel="stylesheet" href="/public/css/teacher.css" type="text/css">
        <link rel="stylesheet" href="/public/css/student.css" type="text/css">
        <link rel="stylesheet" href="/public/css/popup.css" type="text/css">
</head>

<body>
    <div class="student_main_dashboard">
        <%- include('partials/member-student-side-navbar.ejs') %>
            <%- include('partials/member-student-top-navbar copy.ejs') %>
                <div class="main_student_content_container">
                    <div class="student_courses">
                        <div class="courses_container">
                            <% if (courses.length !=0) { var i=0; courses.forEach (function (course) { %>
                                <div class="course-card">


                                    <h2>
                                        <%= course.course_name %>
                                    </h2>

                                    <a href="/student-class-page/<%=course.ID %>" class="link">View Course</a>
                                </div>

                                <% i++;});} %>
                        </div>
                    </div>
                </div>
    </div>
    </div>

    <div class="mini_popup_container" id="mini_popup_container">
        <div class="popup_content popup_page_container">
            <div>
                <h1 class="page_title" style="margin: 0 0; text-align: left; font-size: 200%;">Join a New Course</h1>
                <p>Provide the details for the course you want to join in;</p>
            </div>
            <div class="form_container">
                <form action="/join-course" method="POST">

                    <div class="input-container">
                        <input type="text" name="course_id" id="course_id" placeholder=" " required>
                        <label for="course_name">Course ID:</label>
                    </div>

                    <div class="input-container">
                        <input type="text" name="course_code" id="course_code" placeholder=" " required>
                        <label for="enrollment_code">Course Join Code:</label>

                    </div>

                    <button type="submit" class="popup_button" style="align-self: center;">Join Course</button>
                </form>
            </div>
        </div>
    </div>

    <script src="public/js/popup.js"></script>

</body>

</html>